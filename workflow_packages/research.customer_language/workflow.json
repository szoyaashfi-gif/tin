{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "research.customer_language",
    "title": "Mine customer language",
    "description": "Turn existing customer evidence in a project into a cited voice-of-customer brief with reusable problem, outcome, objection and messaging language.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "focus": {
          "type": "string",
          "maxLength": 2000,
          "title": "Question or audience to focus on",
          "default": "",
          "x-tin-ui": {
            "control": "textarea",
            "order": 10
          }
        },
        "source_hint": {
          "type": "string",
          "maxLength": 1000,
          "title": "Optional source hint",
          "default": ""
        }
      },
      "required": ["project_id"]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/customer-language/SKILL.md"
      ],
      "entry_skill": "customer-language",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/CUSTOMER_LANGUAGE.md",
        "media_type": "text/markdown",
        "max_bytes": 40000
      }
    }
  }
}
