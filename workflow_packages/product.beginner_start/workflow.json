{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "product.beginner_start",
    "title": "Make a beginner start guide",
    "description": "Turn an unfamiliar project into a simple first-steps guide for someone new to it.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "focus": {
          "type": "string",
          "maxLength": 1000,
          "title": "What do you want to understand?",
          "default": "",
          "x-tin-ui": {
            "control": "textarea",
            "order": 10
          }
        }
      },
      "required": ["project_id"]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/beginner-start/SKILL.md"
      ],
      "entry_skill": "beginner-start",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 600
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/BEGINNER_START.md",
        "media_type": "text/markdown",
        "max_bytes": 20000
      }
    }
  }
}
